<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Guelph Parks &mdash; OSM Coverage Gaps</title>
<link rel="stylesheet" href="../index.css">
<link rel="stylesheet" href="gaps.css">
<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="">
<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>
<script defer src="gaps.js"></script>
<script data-goatcounter="https://osm-guelph.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head>
<body class="app">

<header class="bar">
  <div class="bar-head">
    <h1>Guelph Parks &mdash; OSM coverage gaps</h1>
    <a class="back" href="../">&larr; reference layer</a>
    <a class="back" href="history.html">gaps over time &rarr;</a>
  </div>
  <div class="counts">
    <div class="count missing"><strong>{{MISSING_COUNT}}</strong><span>missing in OSM</span></div>
    <div class="count mismatch"><strong>{{MISMATCH_COUNT}}</strong><span>name mismatches</span></div>
    <div class="count unnamed"><strong>{{UNNAMED_COUNT}}</strong><span>OSM area unnamed</span></div>
    <div class="count placeholder"><strong>{{PLACEHOLDER_COUNT}}</strong><span>City name is a placeholder</span></div>
    <div class="count notoilet"><strong>{{NOTOILET_COUNT}}</strong><span>restrooms not in OSM</span></div>
    <div class="count nosplashpad"><strong>{{NOSPLASHPAD_COUNT}}</strong><span>splash pads</span></div>
    <div class="count nodiscgolf"><strong>{{NODISCGOLF_COUNT}}</strong><span>disc golf</span></div>
    <div class="count nocapacity"><strong>{{NOCAPACITY_COUNT}}</strong><span>lots without capacity</span></div>
    <div class="count"><strong>{{CITY_COUNT}}</strong><span>City polygons</span></div>
    <div class="count"><strong>{{OSM_COUNT}}</strong><span>OSM park areas</span></div>
    <div class="count meta-count">City data {{DATA_DATE}} &middot; OSM data {{OSM_DATE}} &middot; compared {{BUILD_DATE}}</div>
  </div>
  {{OSM_NOTE}}
  {{AMENITY_NOTE}}
  <p class="licence">
    <a href="{{LICENSE_URL}}">{{LICENSE_NOTICE}}</a>
    Sources: <a href="{{DATASET_PAGE}}">Park Boundary</a>,
    <a href="{{PARK_LOCATION_URL}}">Park Location</a>,
    <a href="{{RESTROOMS_URL}}">Restrooms</a>.
  </p>
</header>

<div class="layout">
  <div id="gap-map"
       data-geojson="gaps.geojson"
       data-raster="../tiles/raster/{z}/{x}/{y}.png"></div>

  <aside class="panel">
    <div class="panel-head">
      <div class="controls">
        <label><span class="swatch missing"></span>
          <input type="checkbox" id="show-missing" checked> Missing</label>
        <label><span class="swatch mismatch"></span>
          <input type="checkbox" id="show-mismatch" checked> Mismatch</label>
        <label><span class="swatch unnamed"></span>
          <input type="checkbox" id="show-unnamed" checked> Unnamed OSM</label>
        <label><span class="swatch placeholder"></span>
          <input type="checkbox" id="show-placeholder"> Placeholder name</label>
        <label><span class="swatch notoilet"></span>
          <input type="checkbox" id="show-notoilet" checked> Restroom</label>
        <label><span class="swatch nosplashpad"></span>
          <input type="checkbox" id="show-nosplashpad" checked> Splash pad</label>
        <label><span class="swatch nodiscgolf"></span>
          <input type="checkbox" id="show-nodiscgolf" checked> Disc golf</label>
        <label><span class="swatch nocapacity"></span>
          <input type="checkbox" id="show-nocapacity"> Lot capacity</label>
        <input type="search" id="filter" placeholder="Filter by name...">
      </div>
      <p class="hint">
        Green fills are the City's parks (raster layer); coloured dots flag the
        gaps. Click a row to outline it on the map, then press <kbd>O</kbd> to
        open it on openstreetmap.org or <kbd>I</kbd> in the iD editor (each row
        has the same <strong>OSM&nbsp;&middot;&nbsp;iD</strong> link pair).
        Matching is by spatial overlap &mdash; verify against imagery before
        editing OSM. <em>Lot capacity</em> is off by default: the City&rsquo;s
        stall count is for the whole park, to be counted from aerial imagery
        across its lots, not copied onto the one the row links to.
      </p>
    </div>
    <div class="table-scroll">
      <table id="gap-table">
        <thead>
          <tr><th class="col-name">Park (City name)</th><th>Address</th>
              <th>Status</th><th>OSM &middot; iD</th></tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </aside>
</div>

</body>
</html>
